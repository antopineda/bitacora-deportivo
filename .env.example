# Archivo de ejemplo de variables de entorno
# Copia este archivo como .env y completa con tus valores reales

# Entorno Rails
RAILS_ENV=production

# Base de datos PostgreSQL
DATABASE_URL=postgres://usuario:password@host:5432/nombre_base_datos

# Rails Master Key (copiada de config/master.key)
RAILS_MASTER_KEY=tu_master_key_aqui

# SSL (dejar en true para producción, false solo para testing local)
# FORCE_SSL=true

# Configuración opcional de Puma
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2

# Logging
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
