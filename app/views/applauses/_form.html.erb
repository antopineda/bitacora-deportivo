<%= form_with(model: applause, local: true, class: "needs-validation", novalidate: true) do |form| %>
  <% if applause.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <h5 class="alert-heading">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <%= pluralize(applause.errors.count, "error") %> impiden guardar:
      </h5>
      <ul class="mb-0">
        <% applause.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, "Nombre", class: "form-label fw-semibold" %>
    <%= form.text_field :name, required: true, class: "form-control", placeholder: "Ej: Aplauso Vikingo, Aplauso de la Lluvia" %>
  </div>

  <div class="mb-3">
    <%= form.label :objective, "Objetivo", class: "form-label fw-semibold" %>
    <%= form.text_field :objective, required: true, class: "form-control", placeholder: "Ej: Motivar al grupo, Celebrar logros" %>
  </div>

  <div class="mb-3">
    <%= form.label :description, "Descripción", class: "form-label fw-semibold" %>
    <%= form.text_area :description, rows: 5, class: "form-control", placeholder: "Describe cómo se realiza el aplauso, instrucciones..." %>
    <div class="form-text">Opcional: Agrega detalles sobre cómo se ejecuta</div>
  </div>

  <div class="mb-4">
    <%= form.label :photo, "Foto (opcional)", class: "form-label fw-semibold" %>
    <%= form.file_field :photo, class: "form-control", accept: "image/*" %>
    <div class="form-text">Opcional: Puedes agregar una imagen ilustrativa si lo deseas</div>
    
    <% if applause.photo.attached? %>
      <div class="mt-3">
        <p class="text-muted mb-2">Vista previa actual:</p>
        <%= image_tag applause.photo, class: "img-thumbnail", style: "max-width: 300px; height: auto;" %>
      </div>
    <% end %>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit applause.persisted? ? "Actualizar aplauso" : "Crear aplauso", class: "btn btn-primary" %>
    <%= link_to "Cancelar", applause.persisted? ? applause : applauses_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
