<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <!-- Header -->
      <div class="mb-4">
        <%= link_to applauses_path, class: "btn btn-sm btn-outline-secondary mb-2" do %>
          <i class="bi bi-arrow-left me-1"></i> Volver
        <% end %>
        <h1 class="h2">
          <i class="bi bi-plus-circle-fill text-primary me-2"></i>
          Nuevo Aplauso
        </h1>
        <p class="text-muted">Completa la información del aplauso</p>
      </div>

      <!-- Formulario en card -->
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <%= render "form", applause: @applause %>
        </div>
      </div>
    </div>
  </div>
</div>
