<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h1 class="h3 m-0">Aplausos</h1>
      <p class="text-muted mb-0">
        <i class="bi bi-list-ol me-1"></i>
        Total: <strong><%= @applauses.count %></strong> <%= @applauses.count == 1 ? 'aplauso' : 'aplausos' %>
      </p>
    </div>
    <%= link_to new_applause_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-circle-fill me-1"></i> Nuevo aplauso
    <% end %>
  </div>

  <div class="table-responsive shadow-sm rounded">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th style="width: 50px;" class="text-center">#</th>
          <th>Nombre</th>
          <th>Objetivo</th>
          <th>Descripción</th>
          <th style="width: 200px;" class="text-end">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if @applauses.any? %>
          <% @applauses.each_with_index do |applause, index| %>
            <tr>
              <td class="text-center fw-bold text-muted"><%= index + 1 %></td>
              <td class="fw-semibold"><%= applause.name %></td>
              <td><%= applause.objective %></td>
              <td><%= truncate(applause.description, length: 120) %></td>
              <td class="text-end">
                <div class="btn-group btn-group-sm" role="group">
                  <%= link_to applause, class: "btn btn-outline-secondary", title: "Ver detalles" do %>
                    <i class="bi bi-eye-fill"></i>
                  <% end %>
                  <%= link_to edit_applause_path(applause), class: "btn btn-outline-primary", title: "Editar" do %>
                    <i class="bi bi-pencil-fill"></i>
                  <% end %>
                  <%= button_to applause, 
                      method: :delete, 
                      form: { data: { turbo_confirm: "¿Seguro que quieres eliminar '#{applause.name}'?" } }, 
                      class: "btn btn-outline-danger",
                      title: "Eliminar" do %>
                    <i class="bi bi-trash-fill"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="5" class="text-center py-5">
              <div class="text-muted">
                <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                <p class="mt-3 mb-0">No hay aplausos registrados todavía</p>
                <small>Comienza agregando tu primer aplauso</small>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
