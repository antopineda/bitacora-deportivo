<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <!-- Header -->
      <div class="mb-4">
        <%= link_to @applause, class: "btn btn-sm btn-outline-secondary mb-2" do %>
          <i class="bi bi-arrow-left me-1"></i> Volver al aplauso
        <% end %>
        <h1 class="h2">
          <i class="bi bi-pencil-fill text-primary me-2"></i>
          Editar Aplauso
        </h1>
        <p class="text-muted">Actualizando: <strong><%= @applause.name %></strong></p>
      </div>

      <!-- Formulario en card -->
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <%= render "form", applause: @applause %>
        </div>
      </div>

      <!-- Botón eliminar -->
      <div class="mt-3">
        <%= button_to applause_path(@applause), 
            method: :delete, 
            form: { data: { turbo_confirm: "¿Estás seguro de eliminar '#{@applause.name}'? Esta acción no se puede deshacer." } },
            class: "btn btn-outline-danger btn-sm" do %>
          <i class="bi bi-trash-fill me-1"></i> Eliminar este aplauso
        <% end %>
      </div>
    </div>
  </div>
</div>
