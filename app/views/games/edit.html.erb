<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <!-- Header -->
      <div class="mb-4">
        <%= link_to @game, class: "btn btn-sm btn-outline-secondary mb-2" do %>
          <i class="bi bi-arrow-left me-1"></i> Volver al juego
        <% end %>
        <h1 class="h2">
          <i class="bi bi-pencil-fill text-primary me-2"></i>
          Editar Juego
        </h1>
        <p class="text-muted">Actualizando: <strong><%= @game.name %></strong></p>
      </div>

      <!-- Formulario en card -->
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <%= render "form", game: @game %>
        </div>
      </div>

      <!-- Botón eliminar -->
      <div class="mt-3">
        <%= button_to game_path(@game), 
            method: :delete, 
            data: { turbo_method: :delete, turbo_confirm: "¿Estás seguro de eliminar '#{@game.name}'? Esta acción no se puede deshacer." },
            class: "btn btn-outline-danger btn-sm" do %>
          <i class="bi bi-trash-fill me-1"></i> Eliminar este juego
        <% end %>
      </div>
    </div>
  </div>
</div>
