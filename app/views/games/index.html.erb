<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Juegos</h1>
    <%= link_to "Nuevo juego", new_game_path, class: "btn btn-primary" %>
  </div>

  <div class="table-responsive shadow-sm rounded">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Foto</th>
          <th>Nombre</th>
          <th>Objetivo</th>
          <th>Descripción</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @games.each do |game| %>
          <tr>
            <td style="width:120px">
              <% if game.photo.attached? %>
                <%= image_tag game.photo, class: "img-fluid rounded", style: "max-width: 100px" %>
              <% end %>
            </td>
            <td><%= game.name %></td>
            <td><%= game.objective %></td>
            <td><%= truncate(game.description, length: 120) %></td>
            <td class="text-end">
              <%= link_to "Ver", game, class: "btn btn-sm btn-outline-secondary" %>
              <%= link_to "Editar", edit_game_path(game), class: "btn btn-sm btn-outline-primary" %>
              <%= link_to "Eliminar", game, data: { turbo_method: :delete, turbo_confirm: "¿Seguro?" }, class: "btn btn-sm btn-outline-danger" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
