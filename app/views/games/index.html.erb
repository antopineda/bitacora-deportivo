<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h1 class="h3 m-0">Juegos</h1>
      <p class="text-muted mb-0">
        <i class="bi bi-list-ol me-1"></i>
        Total: <strong><%= @games.count %></strong> <%= @games.count == 1 ? 'juego' : 'juegos' %>
      </p>
    </div>
    <%= link_to new_game_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-circle-fill me-1"></i> Nuevo juego
    <% end %>
  </div>

  <div class="table-responsive shadow-sm rounded">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th style="width: 50px;" class="text-center">#</th>
          <th style="width: 120px;">Foto</th>
          <th>Nombre</th>
          <th>Objetivo</th>
          <th>Descripción</th>
          <th style="width: 200px;" class="text-end">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if @games.any? %>
          <% @games.each_with_index do |game, index| %>
            <tr>
              <td class="text-center fw-bold text-muted"><%= index + 1 %></td>
              <td>
                <% if game.photo.attached? %>
                  <%= image_tag game.photo, class: "img-fluid rounded", style: "max-width: 100px; height: auto;" %>
                <% else %>
                  <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 100px; height: 75px;">
                    <i class="bi bi-image text-muted" style="font-size: 2rem;"></i>
                  </div>
                <% end %>
              </td>
              <td class="fw-semibold"><%= game.name %></td>
              <td><%= game.objective %></td>
              <td><%= truncate(game.description, length: 120) %></td>
              <td class="text-end">
                <div class="btn-group btn-group-sm" role="group">
                  <%= link_to game, class: "btn btn-outline-secondary", title: "Ver detalles" do %>
                    <i class="bi bi-eye-fill"></i>
                  <% end %>
                  <%= link_to edit_game_path(game), class: "btn btn-outline-primary", title: "Editar" do %>
                    <i class="bi bi-pencil-fill"></i>
                  <% end %>
                  <%= button_to game, 
                      method: :delete, 
                      form: { data: { turbo_confirm: "¿Seguro que quieres eliminar '#{game.name}'?" } }, 
                      class: "btn btn-outline-danger",
                      title: "Eliminar" do %>
                    <i class="bi bi-trash-fill"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" class="text-center py-5">
              <div class="text-muted">
                <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                <p class="mt-3 mb-0">No hay juegos registrados todavía</p>
                <small>Comienza agregando tu primer juego</small>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
