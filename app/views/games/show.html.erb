<div class="container py-4">
  <% if notice.present? %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="bi bi-check-circle-fill me-2"></i>
      <%= notice %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% end %>

  <!-- Header con título y botones -->
  <div class="d-flex justify-content-between align-items-start mb-4">
    <h1 class="h2 mb-0">
      <i class="bi bi-trophy-fill text-warning me-2"></i>
      <%= @game.name %>
    </h1>
    <div class="btn-group" role="group">
      <%= link_to edit_game_path(@game), class: "btn btn-outline-primary" do %>
        <i class="bi bi-pencil-fill me-1"></i> Editar
      <% end %>
      <%= button_to game_path(@game), 
          method: :delete, 
          data: { turbo_method: :delete, turbo_confirm: "¿Estás seguro de eliminar este juego?" },
          class: "btn btn-outline-danger" do %>
        <i class="bi bi-trash-fill me-1"></i> Eliminar
      <% end %>
    </div>
  </div>

  <!-- Contenido principal -->
  <div class="row">
    <!-- Imagen -->
    <% if @game.photo.attached? %>
      <div class="col-md-5 mb-4">
        <div class="card shadow-sm">
          <div class="card-body p-0">
            <%= image_tag @game.photo, class: "img-fluid rounded", alt: @game.name %>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Información -->
    <div class="<%= @game.photo.attached? ? 'col-md-7' : 'col-12' %>">
      <div class="card shadow-sm mb-3">
        <div class="card-body">
          <h5 class="card-title text-primary">
            <i class="bi bi-bullseye me-2"></i>
            Objetivo
          </h5>
          <p class="card-text fs-5"><%= @game.objective %></p>
        </div>
      </div>

      <% if @game.description.present? %>
        <div class="card shadow-sm">
          <div class="card-body">
            <h5 class="card-title text-primary">
              <i class="bi bi-card-text me-2"></i>
              Descripción
            </h5>
            <div class="card-text">
              <%= simple_format(@game.description) %>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Metadatos -->
      <div class="mt-3">
        <small class="text-muted">
          <i class="bi bi-calendar-plus me-1"></i>
          Creado: <%= l(@game.created_at, format: :long) %>
        </small>
      </div>
    </div>
  </div>

  <!-- Botón volver -->
  <div class="mt-4">
    <%= link_to games_path, class: "btn btn-outline-secondary" do %>
      <i class="bi bi-arrow-left me-1"></i> Volver a la lista
    <% end %>
  </div>
</div>
