<div class="container py-5">
  <div class="text-center mb-5">
    <h1 class="display-3 fw-bold mb-3">🎰 Ruletas</h1>
    <p class="lead text-muted">Selecciona qué tipo de ruleta quieres girar</p>
  </div>

  <div class="row g-4">
    <!-- Ruleta de Juegos -->
    <div class="col-md-6 col-lg-3">
      <div class="card h-100 shadow-sm hover-card">
        <div class="card-body text-center p-4">
          <div class="mb-3" style="font-size: 4rem;">⚽</div>
          <h3 class="card-title mb-3">Juegos</h3>
          <p class="text-muted mb-4">Ruleta de juegos</p>
          <%= link_to "Girar Ruleta", roulette_games_path, class: "btn btn-primary btn-lg w-100" %>
        </div>
      </div>
    </div>

    <!-- Ruleta de Dinámicas -->
    <div class="col-md-6 col-lg-3">
      <div class="card h-100 shadow-sm hover-card">
        <div class="card-body text-center p-4">
          <div class="mb-3" style="font-size: 4rem;">⚡</div>
          <h3 class="card-title mb-3">Dinámicas</h3>
          <p class="text-muted mb-4">Ruleta de dinámicas grupales</p>
          <%= link_to "Girar Ruleta", roulette_dynamics_path, class: "btn btn-success btn-lg w-100" %>
        </div>
      </div>
    </div>

    <!-- Ruleta de Aplausos -->
    <div class="col-md-6 col-lg-3">
      <div class="card h-100 shadow-sm hover-card">
        <div class="card-body text-center p-4">
          <div class="mb-3" style="font-size: 4rem;">👏</div>
          <h3 class="card-title mb-3">Aplausos</h3>
          <p class="text-muted mb-4">Ruleta de aplausos</p>
          <%= link_to "Girar Ruleta", roulette_applauses_path, class: "btn btn-warning btn-lg w-100" %>
        </div>
      </div>
    </div>

    <!-- Ruleta de TODO -->
    <div class="col-md-6 col-lg-3">
      <div class="card h-100 shadow-sm hover-card border-danger">
        <div class="card-body text-center p-4">
          <div class="mb-3" style="font-size: 4rem;">🌟</div>
          <h3 class="card-title mb-3">TODO</h3>
          <p class="text-muted mb-4">¡Todas las actividades juntas!</p>
          <%= link_to "Girar Ruleta", roulette_all_path, class: "btn btn-danger btn-lg w-100" %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .hover-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .hover-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.2) !important;
  }
</style>
