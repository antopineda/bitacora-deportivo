<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
      <!-- Header -->
      <div class="mb-4">
        <%= link_to @reflection, class: "btn btn-outline-secondary mb-3" do %>
          <i class="bi bi-arrow-left"></i> Volver
        <% end %>
        
        <div class="card shadow-sm border-0">
          <div class="card-body p-4">
            <div class="text-center mb-4">
              <i class="bi bi-pencil-square text-primary" style="font-size: 3rem;"></i>
              <h2 class="mt-3 mb-2 fw-bold">Editar Reflexión</h2>
              <p class="text-muted">Actualiza tu reflexión</p>
            </div>

            <%= render "form", reflection: @reflection %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
