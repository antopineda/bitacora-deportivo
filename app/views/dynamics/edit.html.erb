<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <!-- Header -->
      <div class="mb-4">
        <%= link_to @dynamic, class: "btn btn-sm btn-outline-secondary mb-2" do %>
          <i class="bi bi-arrow-left me-1"></i> Volver a la dinámica
        <% end %>
        <h1 class="h2">
          <i class="bi bi-pencil-fill text-primary me-2"></i>
          Editar Dinámica
        </h1>
        <p class="text-muted">Actualizando: <strong><%= @dynamic.name %></strong></p>
      </div>

      <!-- Formulario en card -->
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <%= render "form", dynamic: @dynamic %>
        </div>
      </div>

      <!-- Botón eliminar -->
      <div class="mt-3">
        <%= button_to dynamic_path(@dynamic), 
            method: :delete, 
            form: { data: { turbo_confirm: "¿Estás seguro de eliminar '#{@dynamic.name}'? Esta acción no se puede deshacer." } },
            class: "btn btn-outline-danger btn-sm" do %>
          <i class="bi bi-trash-fill me-1"></i> Eliminar esta dinámica
        <% end %>
      </div>
    </div>
  </div>
</div>
