<%= form_with(model: dynamic, local: true, class: "needs-validation", novalidate: true) do |form| %>
  <% if dynamic.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <h5 class="alert-heading">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <%= pluralize(dynamic.errors.count, "error") %> impiden guardar:
      </h5>
      <ul class="mb-0">
        <% dynamic.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, "Nombre", class: "form-label fw-semibold" %>
    <%= form.text_field :name, required: true, class: "form-control", placeholder: "Ej: Rompehielos, Presentación creativa" %>
  </div>

  <div class="mb-3">
    <%= form.label :objective, "Objetivo", class: "form-label fw-semibold" %>
    <%= form.text_field :objective, required: true, class: "form-control", placeholder: "Ej: Romper el hielo, Conocerse mejor" %>
  </div>

  <div class="mb-3">
    <%= form.label :description, "Descripción", class: "form-label fw-semibold" %>
    <%= form.text_area :description, rows: 5, class: "form-control", placeholder: "Describe la dinámica, instrucciones, materiales necesarios..." %>
    <div class="form-text">Opcional: Agrega detalles sobre cómo se realiza</div>
  </div>

  <div class="mb-4">
    <%= form.label :photo, "Foto (opcional)", class: "form-label fw-semibold" %>
    <%= form.file_field :photo, class: "form-control", accept: "image/*" %>
    <div class="form-text">Opcional: Puedes agregar una imagen ilustrativa si lo deseas</div>
    
    <% if dynamic.photo.attached? %>
      <div class="mt-3">
        <p class="text-muted mb-2">Vista previa actual:</p>
        <%= image_tag dynamic.photo, class: "img-thumbnail", style: "max-width: 300px; height: auto;" %>
      </div>
    <% end %>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit dynamic.persisted? ? "Actualizar dinámica" : "Crear dinámica", class: "btn btn-primary" %>
    <%= link_to "Cancelar", dynamic.persisted? ? dynamic : dynamics_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
