# Archivo de configuración para producción en EC2
# Copia este archivo como .env en el servidor EC2 y completa los valores

# Entorno Rails
RAILS_ENV=production

# Base de datos PostgreSQL
# Ajusta según tu configuración de PostgreSQL en EC2 o RDS
DATABASE_URL=postgres://postgres:clavesecreta123@db:5432/app_production

# Rails Master Key (copiada de config/master.key)
RAILS_MASTER_KEY=0da63500cf73777007e774915677f8fb

# AWS S3 Configuration
# Opción 1: Usar variables de entorno (recomendado cuando AWS_EC2_METADATA_DISABLED=true)
# Descomenta y completa estas líneas con tus credenciales de AWS:
# AWS_ACCESS_KEY_ID=tu_access_key_id_aqui
# AWS_SECRET_ACCESS_KEY=tu_secret_access_key_aqui
# AWS_REGION=us-east-2
# AWS_BUCKET=bitacora-deportivo-prod

# Opción 2: Usar Rails credentials (credentials.yml.enc)
# Si prefieres usar credentials encriptados, comenta las variables arriba
# y ejecuta: docker compose run --rm -e EDITOR=nano web bin/rails credentials:edit
# Agrega:
# aws:
#   access_key_id: TU_ACCESS_KEY_ID
#   secret_access_key: TU_SECRET_ACCESS_KEY

# SSL habilitado para producción (Caddy manejará los certificados)
# FORCE_SSL=true (por defecto es true, solo descomenta si necesitas desactivarlo temporalmente)

# Configuración opcional de Puma
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2

# Logging
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
